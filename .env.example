DATABASE_URL="postgresql://fystay:fystay@localhost:5432/fystay?schema=public"
# Used only by Prisma Migrate/CLI, not the running app. Locally this can be
# the same value as DATABASE_URL. On Supabase/PgBouncer-fronted setups it
# must be the direct (non-pooled) connection string — see README.
DIRECT_URL="postgresql://fystay:fystay@localhost:5432/fystay?schema=public"

AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Used for host photo uploads (Supabase Storage). NEXT_PUBLIC_SUPABASE_URL is
# not sensitive. SUPABASE_SERVICE_ROLE_KEY is a secret — never expose it to
# the client; it's only read in server-side code (src/lib/storage.ts). If
# unset, the photo upload button shows an error but the rest of the app
# (including pasting photo URLs directly) still works.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
