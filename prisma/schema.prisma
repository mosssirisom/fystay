// Prisma schema for Fystay — an Airbnb-style booking marketplace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  GUEST
  HOST
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(GUEST)
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  listings Listing[]
  bookings Booking[]
  reviews  Review[]
  savedListings SavedListing[]
  passwordResetTokens PasswordResetToken[]
}

// A single-use, time-limited token for the "forgot password" flow. Only a
// hash of the token is stored, so a database leak alone can't be used to
// reset anyone's password (same principle as storing password hashes, not
// passwords).
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  city        String
  country     String
  address     String?
  pricePerNightCents Int
  // A flat, once-per-stay fee (housekeeping between guests), separate from
  // the nightly rate. Zero means the host hasn't set one, in which case the
  // booking summary simply omits that line rather than showing "£0".
  cleaningFeeCents  Int      @default(0)
  maxGuests   Int      @default(1)
  bedrooms    Int      @default(1)
  beds        Int      @default(1)
  bathrooms   Int      @default(1)
  photos      String[]
  amenities   String[]
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hostId   String
  host     User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings Booking[]
  reviews  Review[]
  savedBy  SavedListing[]

  @@index([city])
  @@index([hostId])
}

model Booking {
  id         String        @id @default(cuid())
  // A short, human-friendly code shown to the guest (e.g. on the
  // confirmation page and "My trips"), distinct from the internal cuid id.
  reference  String        @unique
  checkIn    DateTime
  checkOut   DateTime
  guests     Int           @default(1)
  nights     Int
  status     BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  // Price breakdown, snapshotted at booking time so a later change to the
  // listing's price or fees never rewrites the price a guest already agreed
  // to. totalPriceCents is always the sum of the four fields above it.
  nightlyPriceCents Int
  cleaningFeeCents  Int @default(0)
  serviceFeeCents   Int @default(0)
  taxCents          Int @default(0)
  totalPriceCents   Int

  // Contact details for this specific stay, captured at checkout. Kept on
  // the booking (rather than read live off the account) so the record
  // reflects who the reservation was actually for even if the account's
  // own name/email changes later.
  guestName  String?
  guestEmail String?
  guestPhone String?

  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  paidAt     DateTime?
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  guestId String
  guest   User   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  review Review?
  changeRequests BookingChangeRequest[]

  @@index([listingId])
  @@index([guestId])
}

// A guest-initiated request to change a CONFIRMED booking's dates or guest
// count, subject to host approval. Kept separate from Booking itself so the
// original booking stays untouched (and its dates keep blocking availability
// for other guests) until the host actually approves the change, and so a
// price increase can be collected via its own Stripe Checkout session before
// the change is applied, mirroring how the initial booking payment works.
model BookingChangeRequest {
  id     String              @id @default(cuid())
  status ChangeRequestStatus @default(PENDING)

  requestedCheckIn  DateTime
  requestedCheckOut DateTime
  requestedGuests   Int
  // requestedTotalPriceCents - the original booking's totalPriceCents at
  // request time. Positive: guest owes more. Negative: guest is due a
  // refund. Zero: applied immediately on approval, no payment step.
  priceDeltaCents Int

  stripeSessionId String?    @unique
  paidAt          DateTime?
  refundedAt      DateTime?
  respondedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // One review per completed stay.
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model SavedListing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}
